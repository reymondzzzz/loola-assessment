🔧 Tool: bash({"command": "python - <<'PY'\nimport json, sqlite3\nfrom collections import defaultdict\nfrom datetime import datetime, timezone\nfrom decimal import Decimal, ROUND_HALF_UP\n\nconnection = sqlite3.connect('file:data/shop.db?mode=ro', uri=True)\nstart = datetime(2026, 3, 1, tzinfo=timezone.utc)\nend = datetime(2026, 4, 1, tzinfo=timezone.utc)\nrevenue = defaultdict(lambda: Decimal('0'))\nfor customer_id, name, created_at, status, qty, unit_price in connection.execute('''\n    SELECT c.id, c.name, o.created_at, o.status, oi.qty, oi.unit_price\n    FROM orders o\n    JOIN customers c ON c.id = o.customer_id\n    JOIN order_items oi ON oi.order_id = o.id\n'''):\n    if status != 'paid':\n        continue\n    timestamp = datetime.fromisoformat(created_at.replace('Z', '+00:00')).astimezone(timezone.utc)\n    if start <= timestamp < end:\n        revenue[customer_id] += Decimal(qty) * Decimal(str(unit_price))\nnames = dict(connection.execute('SELECT id, name FROM customers'))\nranked = []\nfor customer_id, amount in revenue.items():\n    rounded = amount.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)\n    ranked.append((customer_id, names[customer_id], rounded))\nranked.sort(key=lambda row: (-row[2], row[0]))\nresult = [{'customer_id': cid, 'name': name, 'revenue': float(amount)} for cid, name, amount in ranked[:3]]\nwith open('top_customers.json', 'w', encoding='utf-8') as file:\n    json.dump(result, file, indent=2)\n    file.write('\\n')\nprint(json.dumps(result, indent=2))\nPY"})

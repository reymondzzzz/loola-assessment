from decimal import ROUND_HALF_UP, Decimal

RATES = {"DE": 0.19, "FR": 0.2, "GB": 0.02, "US": 0.0, "ES": 0.21, "NL": 0.21}


def compute_tax(amount: float, country: str) -> float:
    """Tax for amount in country, rounded to cents half up. Unknown country raises KeyError."""
    rate = Decimal(str(RATES[country]))
    return float((Decimal(str(amount)) * rate).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP))

🔧 Tool: bash({"command": "echo 'import csv\nimport json\nfrom inventory.models import Item\nfrom inventory.store import Store\n\nstore = Store()\n\nwith open(\"data/items.csv\", encoding=\"utf-8-sig\", newline=\"\") as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if not any(row.values()):\n            continue\n        name = row[\"name\"].strip()\n        price = float(row[\"price\"].strip())\n        qty = int(row[\"qty\"].strip())\n        store.add(Item(name, price, qty))\n\nlow_stock_names = set(store.low_stock(5))\n\nwith open(\"data/suppliers.json\") as f:\n    data = json.load(f)\n\nrestock_supplier_ids = []\n\nlow_stock_names_lower = {name.lower() for name in low_stock_names}\n\nfor supplier in data[\"suppliers\"]:\n    if not supplier.get(\"active\", False):\n        continue\n    catalog = supplier.get(\"catalog\", [])\n    for item in catalog:\n        sku = item.get(\"sku\", \"\").lower()\n        if sku in low_stock_names_lower:\n            restock_supplier_ids.append(supplier[\"id\"])\n            break\n\nrestock_supplier_ids.sort()\n\nwith open(\"restock_suppliers.json\", \"w\") as f:\n    json.dump(restock_supplier_ids, f, indent=4)\n' > restock_suppliers.py"})

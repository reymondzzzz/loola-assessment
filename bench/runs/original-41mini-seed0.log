🔧 Tool: bash({"command": "echo \"import csv, json\nfrom inventory.models import Item\nfrom inventory.store import Store\n\nstore = Store()\n\nwith open('data/items.csv', encoding='utf-8-sig', newline='') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        if not any(row.values()):\n            continue\n        name = row['name'].strip()\n        price = float(row['price'].strip())\n        qty = int(row['qty'].strip())\n        store.add(Item(name, price, qty))\n\nlow_stock = set(store.low_stock(5))\n\nwith open('data/suppliers.json') as f:\n    data = json.load(f)\n\nresult = []\nfor supplier in data['suppliers']:\n    if not supplier.get('active'):\n        continue\n    catalog = supplier.get('catalog', [])\n    for item in catalog:\n        if item['sku'].lower() in (name.lower() for name in low_stock):\n            result.append(supplier['id'])\n            break\n\nresult.sort()\n\nwith open('restock_suppliers.json', 'w') as f:\n    json.dump(result, f, indent=4)\n\" > restock_suppliers.py"})
